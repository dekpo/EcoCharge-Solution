# Copy to `.env` (gitignored) at the repo root to override docker-compose defaults.

# Backend connection string used inside the "api" container.
# Default targets SQLite; for Postgres profile use something like:
# Host=postgres;Port=5432;Database=ecocharge;Username=ecocharge;Password=ecocharge_dev_only
ECOCHARGE_CONNECTION_STRING=Data Source=/data/ecocharge.db

# Origin allowed by the API's CORS policy (must match where the client is served from).
ECOCHARGE_CLIENT_ORIGIN=http://localhost:5173

# Base URL the client (built inside Docker) will call.
ECOCHARGE_API_BASE_URL=http://localhost:5080

# Only used when running with --profile postgres.
ECOCHARGE_DB_PASSWORD=change_me_in_production
