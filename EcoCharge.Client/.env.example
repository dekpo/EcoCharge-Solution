# Copy this file to `.env.local` and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Base URL of the EcoCharge.Api backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:5080

# Polling interval (ms) used by useStations / useLiveConsumption hooks.
VITE_POLL_INTERVAL_MS=5000
